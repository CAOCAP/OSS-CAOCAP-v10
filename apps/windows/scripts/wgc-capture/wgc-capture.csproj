<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>wgc-capture</AssemblyName>
    <RootNamespace>WgcCapture</RootNamespace>
    <Description>
      CI helper: one-frame window or monitor capture to PNG via Windows.Graphics.Capture.
      Adapted from glasscap (MIT), https://github.com/bandersong/glasscap
    </Description>
  </PropertyGroup>
</Project>
