    "help.article.nextSteps.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد المقدمة واختيار المساعد تصل إلى لوحة رئيسية فارغة. حرّك وكبّر لتستكشف المساحة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After intro and persona pick, you land on an empty Home canvas. Pan and zoom to look around."
          }
        }
      }
    },
    "help.article.nextSteps.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح CoCaptain من الزر العائم عندما تحتاج مساعدة. الملف الشخصي والإعدادات تبقى في الواجهة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open CoCaptain from the FAB when you want help. Profile and Settings stay in the HUD."
          }
        }
      }
    },
    "help.article.nextSteps.body3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المساعدة هنا للوحة وCoCaptain واختصارات الأوامر. لا يوجد درس إلزامي للتطبيقات المصغّرة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help stays here for canvas, CoCaptain, and command shortcuts. There is no required mini-app lesson."
