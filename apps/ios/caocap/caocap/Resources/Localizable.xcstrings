    },
    "Hello, CAOCAP" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحباً بك في CAOCAP"
          }
        }
      }
    },
    "Hello! I'm your Co-Captain. How can I help you build today?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحباً! أنا مساعدك Co-Captain. كيف يمكنني مساعدتك في البناء اليوم؟"
          }
        }
      }
    },
    "Help" : {
      "extractionState" : "manual",
