    "help.article.miniapps.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mini-App nodes bundle HTML, CSS, and JavaScript with a live preview on the canvas."
          }
        }
      }
    },
    "help.article.miniapps.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a mini-app node to edit code, refine the SRS, and run your build instantly."
          }
        }
      }
    },
    "help.article.miniapps.subtitle" : {
