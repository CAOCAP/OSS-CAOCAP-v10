    "help.article.canvas.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللوحة الرئيسية هي مساحة عملك غير المحدودة. البطاقات التي تضيفها تظهر هنا. تبدأ الصفحة الرئيسية فارغة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your home canvas is an infinite workspace. Cards you add live here. Home starts empty."
          }
        }
      }
    },
    "help.article.canvas.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب للتنقل، قرّب للتركيز، واضغط على العقدة لفتح ما تحتويه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to pan, pinch to zoom, and tap a node to open what it contains."
          }
        }
      }
    },
    "help.article.canvas.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan, zoom, and organize your spatial workspace"
          }
        }
      }
    },
    "help.article.canvas.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvas & nodes"
          }
        }
      }
    },
    "help.article.cocaptain.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoCaptain reads your current canvas and helps you plan and explain it."
          }
        }
      }
    },
    "help.article.cocaptain.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code and structural changes stay in review until you approve them."
          }
        }
      }
    },
    "help.article.cocaptain.body3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use View on Canvas inside a review card to inspect the target node before applying. Node-scoped reviews stay pending until you approve or reject them, even if you leave and return later."
          }
        }
      }
    },
    "help.article.cocaptain.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your AI mentor with human-in-the-loop edits"
          }
        }
      }
    },
    "help.article.cocaptain.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoCaptain & review"
