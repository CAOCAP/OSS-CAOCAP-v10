rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isNonAnonymousOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isNonAnonymousOwner(userId);
    }

    match /users/{userId}/commands/{commandId} {
      allow read: if isNonAnonymousOwner(userId);
      allow create, delete: if false;
      allow update: if isNonAnonymousOwner(userId)
        && request.resource.data.type == resource.data.type
        && request.resource.data.url == resource.data.url
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'claimed')
          || (resource.data.status == 'claimed'
            && request.resource.data.status in ['opened', 'failed'])
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
